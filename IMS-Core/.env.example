# ---------------------------------------------------------------------------
# IMS-Core configuration
#
# Docker Compose reads this file automatically when it is named `.env`.
#   cp .env.example .env
#
# Infrastructure secrets (database password, Redis password, master key, JWT
# secret, setup token) are generated automatically by the `init` container on
# first start and stored in the `ims-secrets` Docker volume. You do NOT need to
# put them here. Only override them for non-Docker deployments.
# ---------------------------------------------------------------------------

# Public domain of this Core instance. Caddy obtains a Let's Encrypt
# certificate for it automatically (ports 80/443 must be reachable).
# Use "localhost" for local testing (self-signed internal CA).
IMS_DOMAIN=itwodms.ir

# Contact e-mail for the ACME / Let's Encrypt account.
ACME_EMAIL=admin@itwodms.ir

# Public URL used in links, the agent install command and Origin checks.
IMS_PUBLIC_URL=https://itwodms.ir

# Host ports published by the web (Caddy) container.
HTTP_PORT=80
HTTPS_PORT=443

# Logging: error | warn | log | debug | verbose
LOG_LEVEL=log

# Access token lifetime in seconds (default 15 minutes).
ACCESS_TOKEN_TTL_SEC=900

# Optional: custom Telegram Bot API base URL (self-hosted Bot API server or relay).
TELEGRAM_API_BASE=https://api.telegram.org

# ---------------------------------------------------------------------------
# Non-Docker / development only (the Docker entrypoint sets these itself)
# ---------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# DATABASE_URL=postgresql://ims:change-me@localhost:5432/ims?schema=public
# REDIS_URL=redis://:change-me@localhost:6379/0
# IMS_MASTER_KEY=<base64 of 32 random bytes>   # openssl rand -base64 32
# JWT_ACCESS_SECRET=<64+ random chars>         # openssl rand -hex 48
# IMS_SETUP_TOKEN=<random>                     # openssl rand -hex 24
# DATA_DIR=./data
# COOKIE_SECURE=false                          # only for http://localhost development
