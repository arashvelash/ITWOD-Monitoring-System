// ---------------------------------------------------------------------------
// IMS-Core database schema (PostgreSQL)
//
// Conventions
//  - UUID primary keys, snake_case table names via @@map.
//  - Secret values are stored ONLY as AES-256-GCM ciphertext (`*Encrypted`)
//    or as one-way hashes (`*Hash`). Never add plaintext secret columns.
//  - Time series / append-only tables use BigInt autoincrement ids.
// See database/README.md for an entity overview.
// ---------------------------------------------------------------------------

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Users & sessions ==============================

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  username            String    @unique @db.VarChar(64)
  email               String?   @unique @db.VarChar(255)
  displayName         String?   @map("display_name") @db.VarChar(128)
  passwordHash        String    @map("password_hash")
  role                UserRole  @default(VIEWER)
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(64)
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions          Session[]
  telegramLinks     TelegramLink[]
  telegramLinkCodes TelegramLinkCode[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(64)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================ Servers / nodes ===============================

enum ServerType {
  UBUNTU
  CPANEL
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
  DECOMMISSIONED
}

model Server {
  id               String       @id @default(uuid()) @db.Uuid
  serial           Int          @unique @default(autoincrement())
  nodeId           String       @unique @map("node_id") @db.VarChar(48)
  name             String       @db.VarChar(128)
  type             ServerType
  operatingSystem  String       @map("operating_system") @db.VarChar(128)
  description      String?      @db.VarChar(1000)
  tags             String[]     @default([])
  status           ServerStatus @default(PENDING)
  hostname         String?      @db.VarChar(255)
  ipAddress        String?      @map("ip_address") @db.VarChar(64)
  osDetails        String?      @map("os_details") @db.VarChar(255)
  arch             String?      @db.VarChar(32)
  agentVersion     String?      @map("agent_version") @db.VarChar(32)
  registeredAt     DateTime?    @map("registered_at")
  lastHeartbeatAt  DateTime?    @map("last_heartbeat_at")
  lastMetricsAt    DateTime?    @map("last_metrics_at")
  latestMetrics    Json?        @map("latest_metrics")
  /// { services: string[], thresholds?: { cpuPercent, memoryPercent, diskPercent } }
  monitoringConfig Json?        @map("monitoring_config")
  /// Incremented whenever anything the agent must know changes (jobs, monitoring).
  configVersion    Int          @default(1) @map("config_version")
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  credential         NodeCredential?
  registrationTokens RegistrationToken[]
  commands           NodeCommand[]
  metrics            NodeMetric[]
  projects           Project[]
  backupJobs         BackupJob[]
  backupRuns         BackupRun[]
  alerts             Alert[]

  @@index([status])
  @@map("servers")
}

model NodeCredential {
  id              String    @id @default(uuid()) @db.Uuid
  serverId        String    @unique @map("server_id") @db.Uuid
  /// AES-256-GCM ciphertext of the node secret (AAD bound to the server id).
  secretEncrypted String    @map("secret_encrypted")
  /// Ed25519 public key, base64 of the raw 32 bytes.
  publicKey       String?   @map("public_key") @db.VarChar(64)
  keyFingerprint  String?   @map("key_fingerprint") @db.VarChar(80)
  keyAlgorithm    String?   @map("key_algorithm") @db.VarChar(16)
  issuedAt        DateTime  @default(now()) @map("issued_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("node_credentials")
}

model RegistrationToken {
  id          String    @id @default(uuid()) @db.Uuid
  serverId    String    @map("server_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  tokenPrefix String    @map("token_prefix") @db.VarChar(16)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedByIp    String?   @map("used_by_ip") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("registration_tokens")
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum CommandOrigin {
  DASHBOARD
  TELEGRAM
  SYSTEM
}

model NodeCommand {
  id             String        @id @default(uuid()) @db.Uuid
  serverId       String        @map("server_id") @db.Uuid
  type           String        @db.VarChar(64)
  /// Non-secret payload only. Secrets are never stored in commands.
  payload        Json
  status         CommandStatus @default(PENDING)
  origin         CommandOrigin @default(DASHBOARD)
  createdById    String?       @map("created_by_id") @db.Uuid
  deliveryCount  Int           @default(0) @map("delivery_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  sentAt         DateTime?     @map("sent_at")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  completedAt    DateTime?     @map("completed_at")
  expiresAt      DateTime      @map("expires_at")
  result         Json?
  errorMessage   String?       @map("error_message") @db.VarChar(2000)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([expiresAt])
  @@map("node_commands")
}

// ============================ Projects & backups ============================

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(128)
  slug        String    @unique @db.VarChar(96)
  description String?   @db.VarChar(2000)
  websiteUrl  String?   @map("website_url") @db.VarChar(512)
  serverId    String?   @map("server_id") @db.Uuid
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  server Server?     @relation(fields: [serverId], references: [id], onDelete: SetNull)
  jobs   BackupJob[]

  @@map("projects")
}

enum BackupType {
  FILES
  MYSQL
  POSTGRES
}

enum BackupDestinationType {
  LOCAL
  S3
}

enum BackupRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
  TELEGRAM
}

model BackupJob {
  id                          String                @id @default(uuid()) @db.Uuid
  name                        String                @db.VarChar(128)
  slug                        String                @db.VarChar(64)
  projectId                   String?               @map("project_id") @db.Uuid
  serverId                    String                @map("server_id") @db.Uuid
  type                        BackupType
  enabled                     Boolean               @default(true)
  /// 5-field cron expression, evaluated by the agent in `timezone`.
  schedule                    String                @db.VarChar(64)
  timezone                    String                @default("UTC") @db.VarChar(64)
  /// FILES: { paths[], excludes[] } · MYSQL/POSTGRES: { host, port, database, username }
  sourceConfig                Json                  @map("source_config")
  /// Encrypted JSON: { dbPassword? }
  sourceSecretsEncrypted      String?               @map("source_secrets_encrypted")
  destinationType             BackupDestinationType @default(LOCAL) @map("destination_type")
  /// S3: { bucket, region, endpoint?, prefix?, forcePathStyle? }
  destinationConfig           Json                  @default("{}") @map("destination_config")
  /// Encrypted JSON: { s3AccessKeyId?, s3SecretAccessKey? }
  destinationSecretsEncrypted String?               @map("destination_secrets_encrypted")
  retentionCount              Int                   @default(7) @map("retention_count")
  retentionDays               Int?                  @map("retention_days")
  encryptionEnabled           Boolean               @default(false) @map("encryption_enabled")
  /// Encrypted base64 AES-256 key used by the agent to encrypt archives.
  encryptionKeyEncrypted      String?               @map("encryption_key_encrypted")
  compressionLevel            Int                   @default(6) @map("compression_level")
  timeoutMinutes              Int                   @default(120) @map("timeout_minutes")
  lastRunAt                   DateTime?             @map("last_run_at")
  lastRunStatus               BackupRunStatus?      @map("last_run_status")
  lastSuccessAt               DateTime?             @map("last_success_at")
  archivedAt                  DateTime?             @map("archived_at")
  createdById                 String?               @map("created_by_id") @db.Uuid
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")

  project Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  server  Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  runs    BackupRun[]
  alerts  Alert[]

  @@unique([serverId, slug])
  @@index([serverId])
  @@map("backup_jobs")
}

model BackupRun {
  id             String          @id @db.Uuid
  jobId          String          @map("job_id") @db.Uuid
  serverId       String          @map("server_id") @db.Uuid
  trigger        BackupTrigger
  status         BackupRunStatus @default(QUEUED)
  commandId      String?         @map("command_id") @db.Uuid
  requestedById  String?         @map("requested_by_id") @db.Uuid
  queuedAt       DateTime        @default(now()) @map("queued_at")
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  durationMs     Int?            @map("duration_ms")
  sizeBytes      BigInt?         @map("size_bytes")
  checksumSha256 String?         @map("checksum_sha256") @db.Char(64)
  fileName       String?         @map("file_name") @db.VarChar(255)
  location       String?         @db.VarChar(1024)
  encrypted      Boolean         @default(false)
  errorMessage   String?         @map("error_message") @db.VarChar(2000)
  logTail        String?         @map("log_tail")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  job    BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  server Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([serverId, createdAt])
  @@index([status])
  @@map("backup_runs")
}

// ============================ Monitoring & alerts ===========================

model NodeMetric {
  id              BigInt   @id @default(autoincrement())
  serverId        String   @map("server_id") @db.Uuid
  collectedAt     DateTime @map("collected_at")
  cpuPercent      Float?   @map("cpu_percent") @db.Real
  load1           Float?   @db.Real
  load5           Float?   @db.Real
  load15          Float?   @db.Real
  memTotalBytes   BigInt?  @map("mem_total_bytes")
  memUsedBytes    BigInt?  @map("mem_used_bytes")
  swapTotalBytes  BigInt?  @map("swap_total_bytes")
  swapUsedBytes   BigInt?  @map("swap_used_bytes")
  /// Highest usage across all mounts, 0-100.
  diskUsedPercent Float?   @map("disk_used_percent") @db.Real
  disks           Json?
  netRxBps        Float?   @map("net_rx_bps")
  netTxBps        Float?   @map("net_tx_bps")
  uptimeSec       Int?     @map("uptime_sec")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, collectedAt])
  @@index([collectedAt])
  @@map("node_metrics")
}

enum AlertType {
  NODE_OFFLINE
  CPU_HIGH
  MEMORY_HIGH
  DISK_HIGH
  SERVICE_DOWN
  BACKUP_FAILED
  BACKUP_MISSED
  AGENT_UPDATE_FAILED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  /// De-duplication key, e.g. "DISK_HIGH:<serverId>:/var".
  fingerprint      String        @db.VarChar(255)
  title            String        @db.VarChar(255)
  message          String        @db.VarChar(2000)
  details          Json?
  serverId         String?       @map("server_id") @db.Uuid
  jobId            String?       @map("job_id") @db.Uuid
  occurrences      Int           @default(1)
  firstSeenAt      DateTime      @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime      @default(now()) @map("last_seen_at")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at")

  server Server?    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  job    BackupJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([fingerprint, status])
  @@index([serverId])
  @@map("alerts")
}

// ============================ Telegram ======================================

model TelegramLink {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  chatId               BigInt    @unique @map("chat_id")
  telegramUserId       BigInt    @map("telegram_user_id")
  telegramUsername     String?   @map("telegram_username") @db.VarChar(64)
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  linkedAt             DateTime  @default(now()) @map("linked_at")
  lastCommandAt        DateTime? @map("last_command_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_links")
}

model TelegramLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_codes")
}

// ============================ Audit & settings ==============================

enum AuditActorType {
  USER
  NODE
  SYSTEM
  TELEGRAM
}

model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(64)
  actorName  String?        @map("actor_name") @db.VarChar(128)
  action     String         @db.VarChar(96)
  targetType String?        @map("target_type") @db.VarChar(64)
  targetId   String?        @map("target_id") @db.VarChar(64)
  success    Boolean        @default(true)
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  userAgent  String?        @map("user_agent") @db.VarChar(512)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model SystemSetting {
  key             String   @id @db.VarChar(128)
  value           Json?
  /// AES-256-GCM ciphertext for secret settings (AAD bound to the key).
  secretEncrypted String?  @map("secret_encrypted")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================ Updates =======================================

enum ReleaseSource {
  GITHUB
  UPLOAD
}

model AgentRelease {
  id           String        @id @default(uuid()) @db.Uuid
  version      String        @unique @db.VarChar(32)
  fileName     String        @map("file_name") @db.VarChar(255)
  sha256       String        @db.Char(64)
  /// Optional base64 Ed25519 signature over the sha256 hex string.
  signature    String?       @db.VarChar(128)
  sizeBytes    BigInt        @map("size_bytes")
  source       ReleaseSource
  storagePath  String        @map("storage_path") @db.VarChar(1024)
  releaseNotes String?       @map("release_notes")
  publishedAt  DateTime?     @map("published_at")
  isRevoked    Boolean       @default(false) @map("is_revoked")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("agent_releases")
}

enum CoreUpdateStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model CoreUpdate {
  id            String           @id @default(uuid()) @db.Uuid
  fromVersion   String           @map("from_version") @db.VarChar(32)
  toVersion     String           @map("to_version") @db.VarChar(32)
  status        CoreUpdateStatus @default(REQUESTED)
  currentStep   String?          @map("current_step") @db.VarChar(64)
  requestedById String?          @map("requested_by_id") @db.Uuid
  requestedAt   DateTime         @default(now()) @map("requested_at")
  startedAt     DateTime?        @map("started_at")
  finishedAt    DateTime?        @map("finished_at")
  log           String?
  errorMessage  String?          @map("error_message") @db.VarChar(2000)

  @@map("core_updates")
}
