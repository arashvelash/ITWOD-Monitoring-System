{
  "name": "ims-core",
  "version": "1.0.0",
  "private": true,
  "description": "ITWOD Monitoring System (IMS) - Core management platform",
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:validate": "npm run prisma:validate -w backend",
    "vectors": "node tests/vectors/generate-vectors.mjs"
  }
}
