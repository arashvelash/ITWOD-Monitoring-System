# ---------------------------------------------------------------------------
# IMS-Agent runtime overrides (all optional).
# The installer writes /etc/ims-agent/agent.env which PM2 loads on start.
# Identity (node id, Core URL, node secret) lives in /etc/ims-agent/identity.json
# and is created by `ims-agent register`, never by hand.
# ---------------------------------------------------------------------------

# Log level: error | warn | info | debug
IMS_AGENT_LOG_LEVEL=info

# Directories (defaults shown)
IMS_AGENT_CONFIG_DIR=/etc/ims-agent
IMS_AGENT_STATE_DIR=/var/lib/ims-agent
IMS_AGENT_INSTALL_DIR=/opt/ims-agent
IMS_AGENT_BACKUP_DIR=/var/backups/ims

# Pinned Ed25519 release signing public key (base64 raw 32 bytes).
# When set, agent updates MUST carry a valid signature.
# IMS_RELEASE_PUBLIC_KEY=

# Development only: allow http:// Core URLs. Never enable in production.
# IMS_ALLOW_INSECURE_CORE=false
